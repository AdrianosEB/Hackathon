PORT=3000

# --------------------------------------------------
# Verification sources
# --------------------------------------------------
VERIFY_IDENTITY=true
VERIFY_SANCTIONS=false
VERIFY_SCOPE=false
VERIFY_HISTORY=false

# Agents. Deterministic stand-ins by default: zero API
# calls, zero tokens.
AGENTS_LIVE=false
AGENTS_RECORD=false

# Point the registry at the local fixture server.
# NPPES_BASE_URL=http://localhost:3101/api/
# ALLOW_LOCAL_WEBSITES=true

# --------------------------------------------------
# Outreach authentication  (REQUIRED)
#
# /api/outreach approves and places telephone calls.
# It refuses every request until one of these is set.
#
# Preferred: named operator tokens. The approver's name
# comes from the token, so nobody can sign someone
# else's name to a call.
# --------------------------------------------------
# OUTREACH_OPERATORS=tok_alice:Alice Chen,tok_raj:Raj Patel

# Fallback. Authenticates the request but cannot
# attribute it — approvedBy is recorded as unverified.
# OUTREACH_SHARED_SECRET=change_me

# --------------------------------------------------
# Vapi outbound calls
#
# TWO SWITCHES. Both must be true before a phone rings.
#
#   VAPI_ADAPTER    arms the adapter in server.js
#   DEMO_AUTO_CALL  checked inside the adapter
#
# With VAPI_ADAPTER unset, dispatch() is a dry run and
# returns the exact payload it would have sent. That is
# the default and the right setting for a demo.
#
# Neither switch bypasses the approval chain: the
# ladder still has to queue a tier-1 phone item and a
# named human still has to approve it.
# --------------------------------------------------
VAPI_ADAPTER=false
DEMO_AUTO_CALL=false

VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# --------------------------------------------------
# WHO GETS CALLED
#
#   demo        one fixed number — your own phone —
#               with synthetic fixture data. No real
#               practice is disturbed. This is the
#               default and you should leave it here.
#
#   production  the NPPES registry number recorded on
#               the outreach row. Never the number
#               printed on the claim: the claim was
#               submitted by the party being checked.
#
# Production needs BOTH variables below. One is too
# easy to set by accident.
# --------------------------------------------------
VAPI_TARGET_MODE=demo
DEMO_BILLING_CONTACT=+15555550123

# VAPI_TARGET_MODE=production
# VAPI_PRODUCTION_ACKNOWLEDGEMENT=I understand this dials real medical practices

# --------------------------------------------------
# Script mode
#
# false  provider_confirmation — provider details only.
#        The only mode allowed to reach a real practice.
#
# true   demo_diagnostic — may carry claim detail, and
#        is permitted ONLY with VAPI_TARGET_MODE=demo,
#        because the demo rings one fixed number
#        holding synthetic data.
# --------------------------------------------------
VAPI_DEMO_SCRIPT=false
